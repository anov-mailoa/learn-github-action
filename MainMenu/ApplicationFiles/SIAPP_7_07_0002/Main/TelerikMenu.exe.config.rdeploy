<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
    <section name="R_ServiceUrlSection" type="R_FrontEnd.R_ServiceUrlSection, REL_FrontEnd" />
  </configSections>

  <R_ServiceUrlSection>
    <R_ServiceUrlExceptionConfigs>
      <add ServiceName="AccessButtonService" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="ConsoleService" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="Helper" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="LoginService" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="MenuService" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="MyProfileService" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ServiceName="SIAPP_PUB_Service" ServiceUrlConfigName="R_DefaultServiceUrl"/>
    </R_ServiceUrlExceptionConfigs>
    <R_ServiceUrlMapConfigs>
      <add ModulId="SA" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ModulId="GS" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ModulId="PQ" ServiceUrlConfigName="R_DefaultServiceUrl"/>
      <add ModulId="PN" ServiceUrlConfigName="R_PNServiceUrl"/>
      <add ModulId="PY" ServiceUrlConfigName="R_PYServiceUrl"/>
      <add ModulId="MC" ServiceUrlConfigName="R_MCServiceUrl"/>
      <add ModulId="LN" ServiceUrlConfigName="R_LNServiceUrl"/>
      <add ModulId="AT" ServiceUrlConfigName="R_ATServiceUrl"/>
      <add ModulId="QA" ServiceUrlConfigName="R_QAServiceUrl"/>
      <add ModulId="ES" ServiceUrlConfigName="R_ESServiceUrl"/>
      <add ModulId="JC" ServiceUrlConfigName="R_JCServiceUrl"/>
    </R_ServiceUrlMapConfigs>
  </R_ServiceUrlSection>
  
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <system.serviceModel>
    <client>
    </client>
    <extensions>
      <behaviorExtensions>
        <add name="ServiceContext" type="R_Common.R_ServiceContextBehavior, REL_Common" />
      </behaviorExtensions>
    </extensions>
    <behaviors>
      <endpointBehaviors>
        <behavior name="DefaultEndPointBehavior">
          <ServiceContext />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <bindings>
      <basicHttpBinding>
        <binding name="StreamingBinding" receiveTimeout="01:50:00" sendTimeout="01:50:00" maxReceivedMessageSize="9223372036854775807" transferMode="StreamedResponse">
          <readerQuotas maxArrayLength="50000000" />
          <security mode="None" />
        </binding>
        <binding name="RegularBinding" receiveTimeout="01:50:00" sendTimeout="01:50:00" maxReceivedMessageSize="50000000" messageEncoding="Mtom">
          <readerQuotas maxArrayLength="50000000" />
          <security mode="None" />
        </binding>
        <binding name="BasicHttpBinding_IMenuService" messageEncoding="Mtom" />
        <binding name="BasicHttpBinding_IMenuStreamingService" />
        <binding name="BasicHttpBinding_ILoginService" messageEncoding="Mtom" />
      </basicHttpBinding>
    </bindings>
  </system.serviceModel>
  <appSettings>
    <add key="U_CompanyLogoFilePath" value="logo_Realta.jpg" />
    <add key="R_Md" value="'QA','SP','PN','GS','SA','AT','PY','LN','MD','MC','ES','JC','PQ'" />
    <add key="OrgChartUrl" value="http://SIAPPSVR:90/OrgChart" />
    <add key="R_ReportFontName" value="Times New Roman"/>
    <add key="R_DefaultServiceUrl" value="http://SIAPPSVR:90/WebApp/MENU/Services"/>
    <add key="R_ATServiceUrl" value="http://SIAPPSVR:90/WebApp/AT/Services"/>
    <add key="R_LNServiceUrl" value="http://SIAPPSVR:90/WebApp/LN/Services"/>
    <add key="R_PNServiceUrl" value="http://SIAPPSVR:90/WebApp/PN/Services"/>
    <add key="R_PYServiceUrl" value="http://SIAPPSVR:90/WebApp/PY/Services"/>
    <add key="R_MCServiceUrl" value="http://SIAPPSVR:90/WebApp/MC/Services"/>
    <add key="R_JCServiceUrl" value="http://SIAPPSVR:90/WebApp/JC/Services"/>
    <add key="R_ESServiceUrl" value="http://SIAPPSVR:90/WebApp/ES/Services"/>
    <add key="R_QAServiceUrl" value="http://SIAPPSVR:90/WebApp/QA/Services"/>

    

    <!--<add key="R_InitPivot" value="INITIALIZE" />-->
    <add key="PosUserTxtBox" value="410,190" />
    <add key="PosPassTxtBox" value="410,245" />
    <add key="PosCompTxtBox" value="410,132" />
    <add key="PosOKBtn" value="548,280" />
    <add key="SizeOKBtn" value="112,37" />
    <add key="PosComplbl" value="408,105" />
    <add key="PosUserlbl" value="408,163" />
    <add key="PosPasslbl" value="408,218" />
    <add key="PosLinklbl" value="480,420" />
    <add key="SizeLoginForm" value="706,460" />
    <add key="ColorFont" value="133,133,133" />
    <add key="SizeTypeFont" value="Myriad Pro,11" />
    <add key="ColorBorderTxt" value="133,133,133" />
    <add key="ImgBG_Login" value="bg-login.jpg" />
    <add key="ImgBG_LoginBtn" value="btn-login.png" />
    <add key="ImgBG_LoginBtnHover" value="btn-login-press.png" />
    <add key="ImgBG_LoginBtnPress" value="btn-login-press.png" />
    <add key="ImgBG_Menu" value="test.jpg" />
    <add key="ImgIcon" value="HRISicon.ico" />
    <add key="CultureUI" value="en,id,ja,zh" />
    <add key="R_HelpNamespace" value="http://SIAPPSVR:90/HELP/" />
    
    <add key="R_ApplicationID" value="SIAPP" />
    <add key="R_DefaultLanguage" value="EN" />
    <add key="R_ChunkSize" value="256" />
    <add key="R_MaxOpenProgram" value="0"/>
    <add key="R_HelpWithDirectory" value="1"/>
  </appSettings>
  <system.net>
    <connectionManagement>
      <add maxconnection="200" address="*" />
    </connectionManagement>
  </system.net>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>