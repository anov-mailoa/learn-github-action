  <RealtaSectionGroup>
    <R_DBSection CommandTimeout="60000">
      <R_DBConfigs>
        <add Name="R_DefaultConnectionString" ConnectionString="server=172.16.0.62\MSSQL14;Initial Catalog=SIAPP_WEB_TEST;User ID=sa;Password=67D09849978483323E213BDD2423583E;" ProviderName="System.Data.SqlClient" KeywordForPassword="Password" />
