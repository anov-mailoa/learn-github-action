name: CI/CD for WCF Backend & WinForms Deployment

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-wcf:
    runs-on: windows-latest

    steps:
    # 1. Checkout code
    - uses: actions/checkout@v4
      with:
        fetch-depth: 0

    # 2. Setup MSBuild and NuGet
    - name: Setup MSBuild
      uses: microsoft/setup-msbuild@v2

    - name: Setup NuGet
      uses: NuGet/setup-nuget@v1.0.5

    # 3. Restore NuGet packages
    - name: Restore NuGet Packages
      run: nuget restore MySolution.sln

    # 4. Build all WCF projects
    - name: Build WCF Projects
      run: |
        msbuild ServiceA/ServiceA.csproj /p:Configuration=Release
        msbuild ServiceB/ServiceB.csproj /p:Configuration=Release
        msbuild ServiceCommon/ServiceCommon.csproj /p:Configuration=Release

    # 5. Publish WCF projects to staging folder
    - name: Create Publish Directory
      run: mkdir PublishArtifacts\WCF

    - name: Publish WCF Services
      run: |
        msbuild ServiceA/ServiceA.csproj /t:Publish /p:Configuration=Release /p:PublishDir=PublishArtifacts\WCF\ServiceA
        msbuild ServiceB/ServiceB.csproj /t:Publish /p:Configuration=Release /p:PublishDir=PublishArtifacts\WCF\ServiceB

    # 6. Debug: List published files
    - name: List Published Files
      run: dir PublishArtifacts /s

    # 7. Upload WCF artifacts
    - name: Upload WCF Artifact
      uses: actions/upload-artifact@v4
      with:
        name: wcf-services-publish
        path: PublishArtifacts\WCF

  deploy:
    runs-on: windows-latest
    needs: build-wcf

    steps:
    # 1. Download WCF artifacts
    - name: Download WCF Artifact
      uses: actions/download-artifact@v4
      with:
        name: wcf-services-publish

    # 2. Deploy WCF Services to IIS
    - name: Deploy WCF Services
      run: |
        "C:\Program Files\IIS\Microsoft Web Deploy V3\msdeploy.exe" ^
        -verb:sync ^
        -source:contentPath=".\PublishArtifacts\WCF\ServiceA" ^
        -dest:auto,computerName="https://${{ secrets.DEPLOY_SERVER }}:8172/msdeploy.axd",userName="${{ secrets.DEPLOY_USER }}",password="${{ secrets.DEPLOY_PASS }}",authType="Basic"

        "C:\Program Files\IIS\Microsoft Web Deploy V3\msdeploy.exe" ^
        -verb:sync ^
        -source:contentPath=".\PublishArtifacts\WCF\ServiceB" ^
        -dest:auto,computerName="https://${{ secrets.DEPLOY_SERVER }}:8172/msdeploy.axd",userName="${{ secrets.DEPLOY_USER }}",password="${{ secrets.DEPLOY_PASS }}",authType="Basic"

    # 3. Deploy WinForms ClickOnce files (from repo)
    - name: Deploy WinForms App
      run: |
        Copy-Item ".\ClickOncePublish\*" "\\${{ secrets.DEPLOY_SERVER }}\DeploymentPath" -Recurse
